# ============================================================
# DEMO: Hardened Dockerfile (.NET 6 - chiseled but still EOL)
# Shows that chiseled reduces surface, but EOL = unpatched CVEs
# ============================================================

# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:6.0 AS build
WORKDIR /src
COPY dotnet/DevSumDemo.csproj .
COPY dotnet/ .
RUN dotnet publish DevSumDemo-legacy.csproj -c Release -o /app/publish \
    && cp -r data /app/publish/data || true

# Stage 2: Runtime (chiseled .NET 6 - minimal but still EOL!)
# Using aspnet chiseled: no shell, no package manager, non-root
# NOT self-contained - so Trivy can detect NuGet dependency CVEs
FROM mcr.microsoft.com/dotnet/aspnet:6.0-jammy-chiseled
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "DevSumDemo.dll"]
